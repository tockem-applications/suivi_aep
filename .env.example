# Copiez en .env :  copy .env.example .env

# Web : Apache 2.2 + PHP 5.3.17 (image kochanup)
APP_PORT=8080

# MySQL 5.1.73 (image vsamov)
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root
DB_NAME=suivi_aep_fokoue
DB_USER=suivi
DB_PASSWORD=suivi

TZ=Africa/Douala

# Docker uniquement : 1 autorise l'app sans verifier la licence (PHP sans openssl)
# WAMP / production : LICENCE_DEV_MODE=0
LICENCE_DEV_MODE=1
