# Node / frontend
# node_modules/
# Garder le lockfile
!package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vendors PHP (si utilisés)
vendor/

# Artéfacts de build
/dist/
/build/
/coverage/
/.cache/
/tmp/
/.idea/
/.vscode/
/tmp/*/*
/tmp/*
# Sauvegardes et exports volumineux
/backups/
/donnees/exports/
/donnees/imports/
/donnees/backups/
/donnees/csv/

# Fichiers de données générés et logs
*.log
log*.txt
*_log.txt
*.tmp
*.cache
*.bak

# Donnees: ignorer les fichiers générés courants
/donnees/*.log
/donnees/log*.txt
/donnees/*_log*.txt
/donnees/*.tmp
/donnees/*.bak
/donnees/*.csv
/donnees/*.json

# Traitement: ignorer les logs et fichiers temporaires
/traitement/*.log
/traitement/log*.txt
# Exemple: autoriser des exemples si besoin
!donnees/example*.json

# Fichiers OS / IDE
.DS_Store
Thumbs.db
/.idea/
/.vscode/

# Fichiers d'environnement
.env
.env.*
!/.env.example
donnees/config.local.php
donnees/licence.json
donnees/licence/active.lic

# Composer (si présent)
composer.lock

# Dumps SQL dans backups/exports (garder schémas à la racine)
/backups/**/*.sql
/donnees/exports/**/*.sql
# Configuration locale / setup applicatif
/app-setup/

# Divers
*.swp
*.swo
*.orig

# --- Donnees produites a l'execution par la collecte mobile -------------------
# Photos des compteurs rapportees par les agents : ce sont des cliches pris chez
# des abonnes reels. Elles n'ont rien a faire dans un depot distant.
/donnees/photos_releve/
# Depot d'attente des imports : contient des releves dechiffres, en clair.
/donnees/imports_temp/
# Fonds de carte hors ligne : plusieurs dizaines de Mo de tuiles binaires,
# regenerables a volonte depuis QGIS ou l'import ZIP.
/donnees/tuiles/

# --- Reecriture v2 -----------------------------------------------------------
# suivi-reseau-v2/ est un projet PERSONNEL, distinct de la v1 qui appartient a
# Tockem. Il partage seulement ce dossier de travail, pas ce depot : rien de ce
# qu'il contient ne doit partir sur le distant de Tockem.
/suivi-reseau-v2/
